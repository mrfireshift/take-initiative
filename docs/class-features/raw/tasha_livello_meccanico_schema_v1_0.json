{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasha mechanical overlay 1.0",
  "type": "object",
  "required": [
    "meta",
    "resource_pools",
    "mechanics",
    "runtime_contract",
    "validation"
  ],
  "properties": {
    "meta": {
      "type": "object"
    },
    "resource_pools": {
      "type": "array"
    },
    "mechanics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "catalog_ref",
          "source",
          "automation_level",
          "activation",
          "targets",
          "duration",
          "resource_costs",
          "effects",
          "completeness"
        ]
      }
    },
    "runtime_contract": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    }
  }
}